{
	"compilerOptions": {
		"target": "es2023",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2023"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": ["./**/*.ts", "../src/lib/game/**/*.ts"]
}
