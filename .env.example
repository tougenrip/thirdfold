# For a physical device, replace localhost with this machine's LAN IP, then
# `npm run build && npx cap sync` (VITE_ values are baked in at build time).
VITE_SUPABASE_URL=http://localhost:54321
# Publishable/anon key printed by `npx supabase start`. Never put the
# secret/service_role key in a VITE_ variable: Vite inlines those into the bundle.
VITE_SUPABASE_ANON_KEY=
# Authoritative game server (`npm run server`). Leave empty to use port 8787 on
# the host that served the page.
VITE_GAME_SERVER_URL=
# Where built assets (models, textures, sounds) are served from: the asset store's public bucket,
# <supabase>/storage/v1/object/public/assets (#191). Leave empty to serve them with the page; the
# native apps always do. Files from there are checked against the
# manifest's SHA-256, which needs a secure context (https or localhost).
VITE_ASSET_BASE_URL=

# --- Game server only (read by `npm run server`, never by the web bundle) ---
# Store saved scenes in Supabase instead of ./data/scenes. Needs the migration in
# supabase/migrations (`npx supabase migration up` locally). The service key
# bypasses row-level security: keep it server-side, never in a VITE_ variable.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_KEY=   # SECRET_KEY (sb_secret_…) or SERVICE_ROLE_KEY from `npx supabase status`
# The same service key uploads built assets with `npm run assets:publish` (docs/ASSETS.md).
# ASSET_STORE_URL=http://127.0.0.1:54321/storage/v1/object/public/assets  # for `npm run assets:pull`
# SCENES_DIR=data/scenes  # file store location when Supabase is not configured
# ROOMS_DIR=data/rooms    # live rooms, kept across restarts
# LIBRARY_DIR=data/library  # the adventure library (published adventures, ratings)
