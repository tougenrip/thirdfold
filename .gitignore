# Vitest screenshot diffs, and the screenshots it takes of failed tests; only the golden images'
# references are kept
.vitest-attachments/
src/**/__screenshots__/*
!src/**/__screenshots__/golden.svelte.spec.ts/

# Private reference shots for look metrics (scripts/look-metrics.mjs); never commit them
.look-refs/

# The surface library's CC0 source sets (scripts/fetch-surfaces.mjs): only their meta.json (and a
# hand-painted touchup.png) are kept; the cooked KTX2 files are in assets/textures
/art/surfaces/*/*
!/art/surfaces/*/meta.json
!/art/surfaces/*/touchup.png
