node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Native / generated
src-tauri/target/
ios/
android/
.capacitor/

# Saved scenes (server/index.ts, SCENES_DIR)
/data/
.claude/

# Vitest screenshot diffs, and the screenshots it takes of failed tests; only the golden images'
# references are kept
.vitest-attachments/
src/**/__screenshots__/*
!src/**/__screenshots__/golden.svelte.spec.ts/

# Private reference shots for look metrics (scripts/look-metrics.mjs); never commit them
.look-refs/

# The surface library's CC0 source sets (scripts/fetch-surfaces.mjs): only their meta.json (and a
# hand-painted touchup.png) are kept; the cooked KTX2 files are in assets/textures
/art/surfaces/*/*
!/art/surfaces/*/meta.json
!/art/surfaces/*/touchup.png

# Generated or fetched art (docs/ASSETS.md): made by a script (the great bell, the stone-halls
# pilot kit and its trim sheet, the characters' pilot minis) or fetched by scripts/fetch-models.ts (the CC0 bridge props, #262);
# only each meta.json is kept
/art/prop/*/*
!/art/prop/*/meta.json
/art/kit/*/*
!/art/kit/*/meta.json
/art/character/*/*
!/art/character/*/meta.json
/art/texture/*/*
!/art/texture/*/meta.json

# Texture detail's 1K and 2K variants (docs/ASSETS.md): cooked here, kept in the asset store
/variants/

# Data backups (npm run data:backup): session tokens and GM key hashes, keep them like the database
/backups/
