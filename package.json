{
	"name": "thirdfold",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"tauri": "tauri",
		"desktop": "tauri dev",
		"desktop:build": "tauri build",
		"mobile:sync": "npm run build && npx cap sync",
		"ios": "npm run mobile:sync && npx cap run ios",
		"android": "npm run mobile:sync && npx cap run android",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"cache:up": "docker compose up -d",
		"cache:down": "docker compose down"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.2",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tauri-apps/cli": "^2.11.5",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"supabase": "^2.117.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.2",
		"@capacitor/core": "^8.5.2",
		"@supabase/supabase-js": "^2.117.1"
	}
}
